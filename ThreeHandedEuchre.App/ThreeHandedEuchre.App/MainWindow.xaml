<Window
    x:Class="ThreeHandedEuchre.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ThreeHandedEuchre.App">

    <Grid Background="Black">

        <!--
        Everything inside this Viewbox is designed at 768 x 512.
        The complete table scales uniformly with the window.
    -->
        <Viewbox Stretch="Uniform"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">

            <Grid Width="910"
              Height="512">

                <!-- Table -->
                <Image Source="/Assets/Images/Backgrounds/euchre_table.png"
                   Width="910"
                   Height="512"
                   Stretch="Fill"/>

                <!-- SCORES -->

                <TextBlock Text="Player 3 (AI-2): 0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="75,15,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Player 1 (Human): 0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,15,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Player 2 (AI-1): 0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,15,75,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"/>


                <!-- LEFT: PLAYER 3 -->
                <StackPanel x:Name="Player3Hand"
                            Orientation="Vertical"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="75,0,0,0"
                            Spacing="8"
                            Visibility="Collapsed">

                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                </StackPanel>

                <!-- RIGHT: PLAYER 2 -->
                <StackPanel x:Name="Player2Hand"
                            Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,55,0"
                            Spacing="8"
                            Visibility="Collapsed">

                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                </StackPanel>

                <!-- HUMAN: PLAYER 1 -->
                <StackPanel x:Name="Player1Hand"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,65"
                            Spacing="8"
                            Visibility="Collapsed">

                    <Image x:Name="HumanCard0"
                           Source="/Assets/Images/Cards/card_back.png"
                           Width="68" Height="102"/>

                    <Image x:Name="HumanCard1"
                           Source="/Assets/Images/Cards/card_back.png"
                           Width="68" Height="102"/>

                    <Image x:Name="HumanCard2"
                           Source="/Assets/Images/Cards/card_back.png"
                           Width="68" Height="102"/>

                    <Image x:Name="HumanCard3"
                           Source="/Assets/Images/Cards/card_back.png"
                           Width="68" Height="102"/>

                    <Image x:Name="HumanCard4"
                           Source="/Assets/Images/Cards/card_back.png"
                           Width="68" Height="102"/>
                </StackPanel>

                <!-- BOTTOM STATUS / CONTROLS -->

                <!-- Dealer -->
                <TextBlock x:Name="DealerText"
                           Text="Dealer: --"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="75,0,0,22"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <!-- Action buttons -->
                <StackPanel x:Name="ActionButtons"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,13"
                            Spacing="8">

                    <Button x:Name="ActionButton1"
                            Content="Play"
                            MinWidth="80"
                            Click="ActionButton1_Click"/>

                    <Button x:Name="ActionButton2"
                            Content=""
                            MinWidth="80"
                            Visibility="Collapsed"
                            Click="ActionButton2_Click"/>

                    <Button x:Name="ActionButton3"
                            Content=""
                            MinWidth="80"
                            Visibility="Collapsed"
                            Click="ActionButton3_Click"/>

                    <Button x:Name="ActionButton4"
                            Content=""
                            MinWidth="80"
                            Visibility="Collapsed"
                            Click="ActionButton4_Click"/>

                </StackPanel>

                <!-- Trump -->
                <TextBlock x:Name="TrumpText"
                           Text="Trump: --"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,75,22"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock x:Name="GameMessage"
                           Text=""
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,-30,0,0"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Visibility="Collapsed"/>


                <!-- ========================================
                     KITTY / UP CARD
                     ======================================== -->

                <local:CardView x:Name="UpCard"
                                Width="68"
                                Height="102"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,75,0,0"/>
                
            </Grid>

        </Viewbox>

    </Grid>

</Window>