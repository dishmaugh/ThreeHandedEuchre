<Window
    x:Class="ThreeHandedEuchre.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Black">

        <!--
        Everything inside this Viewbox is designed at 768 x 512.
        The complete table scales uniformly with the window.
    -->
        <Viewbox Stretch="Uniform"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">

            <Grid Width="910"
              Height="512">

                <!-- Table -->
                <Image Source="/Assets/Images/Backgrounds/euchre_table.png"
                   Width="910"
                   Height="512"
                   Stretch="Fill"/>

                <!-- SCORES -->

                <TextBlock Text="Player 2 (AI-1): 0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="75,15,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Player 1 (Human): 0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,15,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Player 3 (AI-2): 0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,15,75,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"/>


                <!-- LEFT AI HAND -->
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="75,0,0,0"
                            Spacing="8">

                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                </StackPanel>

                <!-- RIGHT AI HAND -->
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,55,0"
                            Spacing="8">

                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="90" Height="60" Stretch="Fill"/>
                </StackPanel>

                <!-- HUMAN HAND -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,65"
                            Spacing="8">

                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="68" Height="102" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="68" Height="102" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="68" Height="102" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="68" Height="102" Stretch="Fill"/>
                    <Image Source="/Assets/Images/Cards/card_back.png"
                            Width="68" Height="102" Stretch="Fill"/>
                </StackPanel>

                <!-- BOTTOM STATUS / CONTROLS -->

                <!-- Dealer -->
                <TextBlock x:Name="DealerText"
                           Text="Dealer: Player 1"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="75,0,0,22"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <!-- Action buttons -->
                <StackPanel x:Name="ActionButtons"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,13"
                            Spacing="8">

                    <Button x:Name="ActionButton1"
                            Content="Pickup"
                            MinWidth="80"/>

                    <Button x:Name="ActionButton2"
                            Content="Pass"
                            MinWidth="80"/>

                    <Button x:Name="ActionButton3"
                            Content=""
                            MinWidth="80"
                            Visibility="Collapsed"/>

                    <Button x:Name="ActionButton4"
                            Content=""
                            MinWidth="80"
                            Visibility="Collapsed"/>
                </StackPanel>

                <!-- Trump -->
                <TextBlock x:Name="TrumpText"
                           Text="Trump: --"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,75,22"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"/>


                <!-- ========================================
                     KITTY / UP CARD
                     ======================================== -->

                <Grid x:Name="UpCard"
                      Width="68"
                      Height="102"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0,75,0,0">

                    <!-- Blank card face -->
                    <Image Source="/Assets/Images/Cards/card_face.png"
                           Width="68"
                           Height="102"
                           Stretch="Fill"/>

                    <!-- Upper-left index -->
                    <StackPanel HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="12,7,0,0"
                                Spacing="-7">

                        <TextBlock Text="A"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="DarkRed"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="♥"
                                   FontSize="15"
                                   Foreground="DarkRed"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Large center suit -->
                    <TextBlock Text="♥"
                               FontSize="42"
                               Foreground="DarkRed"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

            </Grid>

        </Viewbox>

    </Grid>

</Window>